# ==============================================================================
# Solix AI — Frontend Configuration (.env.example)
# ==============================================================================

# Public FastAPI Backend API URL
#
# LOCAL DEVELOPMENT:
# Point to your local FastAPI server instance:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# VERCEL PRODUCTION DEPLOYMENT:
# In Vercel Project Settings -> Environment Variables, set:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# (e.g., exposed via Cloudflare Tunnel, VPS, or Railway/Render/Fly.io)
#
# NOTE: Do NOT use localhost:8000 on Vercel production, because user browsers
# would attempt to reach localhost on their own devices.
