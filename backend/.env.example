# ==============================================================================
# Solix AI — Backend Configuration (.env)
# ==============================================================================

# Ollama AI Configuration (Local daemon or remote Ollama server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120.0

# Database Configuration (SQLite async default, PostgreSQL ready: postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./solix.db

# CORS Configuration
# Comma-separated list of allowed origins (e.g. for Vercel production and local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://solix.vercel.app

# Optional dedicated production frontend URL
# FRONTEND_URL=https://solix.yourdomain.com

# Server Binding
HOST=0.0.0.0
PORT=8000
APP_ENV=development
