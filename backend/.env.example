# ==============================================================================
# Solix AI — Backend Configuration (.env)
# ==============================================================================

# Ollama AI Configuration (Local daemon or remote Ollama server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_WEB_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120.0

# Tavily Web Search Configuration
# Get a free API key at https://tavily.com (1000 searches/month on free tier)
# Required to enable Web Search mode in Solix.
# Run: ollama pull qwen3:8b   (required for web search)
TAVILY_API_KEY=

# Database Configuration (SQLite async default, PostgreSQL ready: postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./solix.db

# CORS Configuration
# Comma-separated list of allowed origins (e.g. for Vercel production and local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://solix.vercel.app

# Optional dedicated production frontend URL
# FRONTEND_URL=https://solix.yourdomain.com

# Server Binding
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# ==============================================================================
# Backend Monitoring Dashboard Configuration
# ==============================================================================
# Accessible at GET / on your backend domain
DASHBOARD_ENABLED=true
# Optional HTTP Basic Auth (Leave empty to disable authentication)
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=your_secure_password
DASHBOARD_MAX_LOGS=500

